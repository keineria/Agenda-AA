# Copia este archivo como .env (producción) o .env.local (desarrollo) y completa los valores.
# Nunca subas el .env real al repositorio.

# --- URL pública -----------------------------------------------------------
# URL completa donde vive la agenda, incluida la subruta. Se usa en correos, enlaces y en Google OAuth.
APP_URL=https://new.aasolutionsllc.com/agenda
# Subruta (basePath) de Next.js. Debe coincidir con APP_URL y se fija al compilar (npm run build).
NEXT_PUBLIC_BASE_PATH=/agenda

# --- Datos -----------------------------------------------------------------
# Base de datos SQLite y carpeta temporal de archivos. Usa rutas absolutas fuera de .next/ (se borra al compilar).
# Si las dejas vacías, PM2 usa <carpeta del repo>/data.
DATABASE_PATH=/home/new.aasolutionsllc.com/agenda/data/agenda.db
UPLOAD_DIR=/home/new.aasolutionsllc.com/agenda/data/uploads

# --- Seguridad (obligatorio en producción) ---------------------------------
# Genera cada uno con:  openssl rand -base64 32
# ENCRYPTION_KEY cifra SSN/ITIN, cuentas bancarias y el token de Google. Si se pierde, esos datos no se recuperan: guárdala aparte.
ENCRYPTION_KEY=
SESSION_SECRET=
# Clave para llamar /agenda/api/cron/reminders?key=... desde un cron externo (opcional).
CRON_SECRET=
# El servidor revisa recordatorios cada 5 minutos por su cuenta. Pon false solo si usas un cron externo.
INTERNAL_CRON=true

# --- Primer superadmin -----------------------------------------------------
# Se crea solo si no existe ningún usuario. Después cambia la contraseña desde Admin › Usuarios.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Superadmin

# --- Avisos internos -------------------------------------------------------
# Correos que reciben aviso de citas nuevas, cambios y cancelaciones (separados por coma).
ADMIN_NOTIFY_EMAILS=infoaasolutionservices@gmail.com
# Destino del formulario de contacto del sitio (si se deja vacío, usa ADMIN_NOTIFY_EMAILS).
CONTACT_NOTIFY_EMAIL=

# --- Correo saliente (SMTP) ------------------------------------------------
# Buzón info@aasolutionsllc.com creado en CyberPanel. Sin SMTP_HOST los correos solo se registran en consola.
SMTP_HOST=mail.aasolutionsllc.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@aasolutionsllc.com
SMTP_PASS=
MAIL_FROM="AA Solutions Services <info@aasolutionsllc.com>"
MAIL_REPLY_TO=infoaasolutionservices@gmail.com

# --- Google (Calendar + Meet, Drive, Sheets) -------------------------------
# Ver GOOGLE_SETUP.md. La cuenta se conecta después desde Admin › Horarios y ajustes › Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendario donde se crean los eventos. "primary" es el calendario principal de la cuenta conectada.
GOOGLE_CALENDAR_ID=primary

# --- Zona horaria del negocio ----------------------------------------------
BUSINESS_TIMEZONE=America/New_York
